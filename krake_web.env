# krake_web.env — Stellschrauben der Krake-Website. Von systemd geladen.
# Ablageort auf dem Pi: /home/molty/.openclaw/krake_web.env  (chmod 600)
# WICHTIG: ANTHROPIC/MISTRAL-Keys NICHT hier — die kommen ueber scripts/.env.

# --- Schutzschichten (Sonjas Werte) ---
KRAKE_TAGESDECKEL=100
KRAKE_IP_PRO_MIN=6
KRAKE_MAX_ZEICHEN=500

# --- CORS: exakt die Website-Herkuenfte ---
KRAKE_ALLOW_ORIGINS=https://firmenwissen-retten.de,https://www.firmenwissen-retten.de

# --- Pfade ---
KRAKE_ZAEHLER_PFAD=/mnt/moltdata/krake_web/zaehler.json
KRAKE_WEB_LOG=/mnt/moltdata/logs/krake_web.log

# --- Mail bei Deckel-Riss ---
# Leer lassen = kein Versand, nur Log-Eintrag. Zum Scharfstellen ausfuellen.
KRAKE_SMTP_HOST=smtp.gmail.com
KRAKE_SMTP_PORT=587
KRAKE_SMTP_USER=
KRAKE_SMTP_PASS=
KRAKE_MAIL_EMPFAENGER=
KRAKE_MAIL_ABSENDER=
