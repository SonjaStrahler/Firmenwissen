[Unit]
Description=Krake-Website Oeffentliche Tuer (Ein offener Blick GmbH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=molty
Group=molty

# >>> VOR "systemctl enable" gegen coach-sparring-stripe.service abgleichen: <<<
# Diese drei Zeilen muessen exakt zum Stripe-Dienst passen (gleiche gunicorn-,
# venv- und EnvironmentFile-Konvention). Nach "systemctl cat" ggf. anpassen.
WorkingDirectory=/home/molty/.openclaw/workspace
EnvironmentFile=/home/molty/.openclaw/krake_web.env
ExecStart=/home/molty/.openclaw/workspace/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8504 scripts.krake_web:app

# --workers 1 mit Absicht: In-Memory-Blitzschutz und Zaehler bleiben so einfach
# und korrekt. Bei max. 100 beantworteten Fragen/Tag reicht ein Worker locker.

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
